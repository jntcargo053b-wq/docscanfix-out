#!/usr/bin/env sh
set -e

# Flutter invokes this script on Android builds. Gradle itself is provisioned
# deterministically by GitHub Actions via gradle/actions/setup-gradle with
# gradle-version: '8.13'. No Gradle Wrapper JAR is used by this project.
if ! command -v gradle >/dev/null 2>&1; then
  echo "ERROR: Gradle is not available on PATH." >&2
  echo "Run gradle/actions/setup-gradle with gradle-version: '8.13' first." >&2
  exit 127
fi

exec gradle "$@"
