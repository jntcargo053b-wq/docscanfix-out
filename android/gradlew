#!/usr/bin/env sh
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROPERTIES="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

GRADLE_VERSION=$(sed -n 's/^distributionUrl=.*gradle-\([^/]*\)-bin\.zip.*$/\1/p' "$PROPERTIES")
GRADLE_SHA256=$(sed -n 's/^distributionSha256Sum=//p' "$PROPERTIES")
: "${GRADLE_VERSION:?Missing Gradle version}"
: "${GRADLE_SHA256:?Missing Gradle checksum}"

# Prefer a provisioned Gradle binary (for example GitHub Actions setup-gradle).
# This avoids relying on a possibly stale/corrupt wrapper cache.
if command -v gradle >/dev/null 2>&1; then
  exec "$(command -v gradle)" "$@"
fi

GRADLE_USER_HOME=${GRADLE_USER_HOME:-"$HOME/.gradle"}
DIST_DIR="$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION-bin"
DIST_ZIP="$DIST_DIR/gradle-$GRADLE_VERSION-bin.zip"
DIST_HOME="$DIST_DIR/gradle-$GRADLE_VERSION"

mkdir -p "$DIST_DIR"

if [ ! -x "$DIST_HOME/bin/gradle" ]; then
  if [ ! -f "$DIST_ZIP" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl --fail --silent --show-error --location \
        --output "$DIST_ZIP" \
        "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    elif command -v wget >/dev/null 2>&1; then
      wget -q -O "$DIST_ZIP" \
        "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    else
      echo "ERROR: curl or wget is required to download Gradle $GRADLE_VERSION." >&2
      exit 1
    fi
  fi

  ACTUAL_SHA256=$(sha256sum "$DIST_ZIP" | awk '{print $1}')
  if [ "$ACTUAL_SHA256" != "$GRADLE_SHA256" ]; then
    echo "ERROR: Gradle distribution checksum mismatch." >&2
    echo "Expected: $GRADLE_SHA256" >&2
    echo "Actual:   $ACTUAL_SHA256" >&2
    rm -f "$DIST_ZIP"
    exit 1
  fi

  rm -rf "$DIST_HOME"
  mkdir -p "$DIST_HOME"
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$DIST_ZIP" -d "$DIST_DIR/.extract"
  else
    echo "ERROR: unzip is required to install Gradle $GRADLE_VERSION." >&2
    exit 1
  fi
  mv "$DIST_DIR/.extract/gradle-$GRADLE_VERSION" "$DIST_HOME"
  rm -rf "$DIST_DIR/.extract"
fi

exec "$DIST_HOME/bin/gradle" "$@"
